# Copy to .env to override. Every value below is also the built-in default,
# so `docker compose up --build` works without a .env at all.

# --- database ---
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry
POSTGRES_DB=spry
POSTGRES_PORT=5432

# --- backend ---
BACKEND_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# --- aws (make deploy-*) ---
# Credentials come from `aws configure` / AWS_PROFILE. Never put keys in this file
# if there is any chance it gets committed.
AWS_REGION=us-east-1
PROJECT_NAME=spry
AWS_PROFILE=

# --- written by the deploy scripts, not by hand ---
BACKEND_URL=
DOMAIN_NAME=
